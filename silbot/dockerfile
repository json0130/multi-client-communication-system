# Start from the official Python 3.10 slim image (Debian-based)
FROM python:3.10-slim-bullseye

# THE FIX: Remove the conflicting apt configuration file before running any apt commands.
# This file is responsible for the "Post-Invoke" error in some build environments.
RUN rm /etc/apt/apt.conf.d/docker-clean

# Now that the conflicting hook is gone, we can safely run all apt commands in a single layer.
# We MUST add back manual cleanup because we disabled the automatic one.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libssl-dev libusb-1.0-0-dev libudev-dev \
    pkg-config libgtk-3-dev libglfw3-dev libgl1-mesa-dev \
    libpulse-dev alsa-utils \
    libportaudio2 libportaudiocpp0 portaudio19-dev \
    ffmpeg python3-dev python3-pip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Combine all Python package installations into a single layer for efficiency.
# Using 'pip' is the standard in python-versioned containers.
RUN pip install --upgrade pip && \
    pip install \
    pyrealsense2 \
    numpy \
    pyttsx3 \
    "python-socketio[client]" \
    websocket-client \
    edge-tts \
    && pip install --no-binary :all: pyaudio

# Set working directory
WORKDIR /app

# Copy your application code into the container
COPY . /app

# Expose port for web streaming
EXPOSE 8080

# Default command
CMD ["bash"]
